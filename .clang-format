# Chosen by the smallest-diff rule on src/winui3paint_p.cpp falling back: no
# clang-format binary was available locally, so LLVM-base + 4-space indent +
# 120-col limit is recorded here without reformatting history (grandfathered
# tree; format new/changed code going forward, ratchet file-by-file).
BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 120
AccessModifierOffset: -4
AlignAfterOpenBracket: Align
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
BreakBeforeBraces: Attach
NamespaceIndentation: None
PointerAlignment: Left
ReferenceAlignment: Left
SortIncludes: false
