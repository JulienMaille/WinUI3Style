# Minimal enforced gate: 5 mechanical checks, warnings are errors.
# Runs on ubuntu CI (clang-tidy job) via -DWINUI3STYLE_CLANG_TIDY=ON, which
# sets CXX_CLANG_TIDY on the library target. Deliberately NOT bugprone-* or
# readability-*: the full sets drown the 100KB dispatcher in unactionable
# noise, and readability-identifier-naming contradicts the tree's m_ member
# convention. Tests/benchmarks are excluded (QtTest idioms); first-party
# shipped code (src, include, plugin, demo) is covered.
Checks: 'bugprone-macro-parentheses,bugprone-sizeof-expression,bugprone-use-after-move,modernize-use-nullptr,modernize-use-override'
WarningsAsErrors: '*'
HeaderFilterRegex: '(src|include|plugin|demo)/.*'
